NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_public_key

# Privada: somente servidor. Necessária para listar/criar contas via Auth Admin.
SUPABASE_SECRET_KEY=

# Privadas: URLs PostgreSQL. Runtime no pooler; migrations na conexão direta/session.
DATABASE_URL=
DIRECT_URL=
DATABASE_POOL_MAX=5
